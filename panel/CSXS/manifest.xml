<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest ExtensionBundleId="com.tklabs.tkcaption"
                   ExtensionBundleName="TK Caption"
                   ExtensionBundleVersion="0.5.1"
                   Version="11.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.tklabs.tkcaption.panel" Version="0.5.1"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Hedef: Premiere Pro 2025 (25.x) ve sonrasi. 2026 = 26.x, bu araliga dahil. -->
      <Host Name="PPRO" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.tklabs.tkcaption.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/bridge.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node.js olmadan yerel whisper.cpp calistirilamaz; CEP'i UXP'ye
                 tercih etmemizin tek sebebi bu bayraktir. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>TK Caption</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
